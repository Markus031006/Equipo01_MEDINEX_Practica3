# Copiar a .env antes de arrancar el servidor Payload local.
# Generar un secreto aleatorio para PAYLOAD_SECRET (no reutilizar el de otro entorno).
PAYLOAD_SECRET=<redacted>
# Local (SQLite, por defecto): la base es un archivo.
DATABASE_URI=file:./medinex.db
# Producción (Postgres en Neon, plan gratuito): cadena de conexión pooled
# con sslmode=require. El adaptador cambia solo según el esquema de la URI
# (`file:` → SQLite, `postgres://` → Postgres).
# DATABASE_URI=postgres://<usuario>:<contraseña>@<host>-pooler.<region>.aws.neon.tech/<base>?sslmode=require

# Orígenes del frontend permitidos además de localhost:5173 y localhost:8443.
# Lista separada por comas. En producción: la URL pública del frontend.
FRONTEND_URL=https://<frontend>.vercel.app

# URL pública de este servidor (para enlaces del admin). En producción: la URL
# pública del servicio backend.
PAYLOAD_SERVER_URL=http://localhost:3000

# Puerto de escucha. `next start` usa PORT si está definido (Vercel lo provee).
# PORT=3000
